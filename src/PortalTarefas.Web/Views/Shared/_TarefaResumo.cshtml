@model TarefaResumoViewModel
@* Partial reutilizada na lista, nos detalhes e no View Component de vencidas. *@
<article class="cartao @(Model.Vencida ? "vencida" : "")">
    <h3><a asp-controller="Tarefas" asp-action="Details" asp-route-id="@Model.Id">@Model.Titulo</a></h3>
    <p class="etiquetas">
        <span class="etiqueta situacao-@Model.Situacao">@Model.Situacao.Exibir()</span>
        <span class="etiqueta prioridade-@Model.Prioridade">Prioridade @Model.Prioridade.Exibir()</span>
        @if (Model.Prazo is not null)
        {
            <span class="etiqueta">Prazo @Model.Prazo.Value.ToString("dd/MM/yyyy")</span>
        }
        @if (Model.Vencida)
        {
            <span class="etiqueta alerta">Vencida</span>
        }
    </p>
</article>
