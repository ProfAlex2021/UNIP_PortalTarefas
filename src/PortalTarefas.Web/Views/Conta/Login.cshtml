@model PortalTarefas.Web.Controllers.LoginViewModel
@{
    ViewData["Title"] = "Entrar";
}
<h1>Entrar</h1>

<form asp-action="Login" method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="erros"></div>
    <input asp-for="RetornoUrl" type="hidden" />
    <div class="campo">
        <label asp-for="Email"></label>
        <input asp-for="Email" autocomplete="username" />
        <span asp-validation-for="Email" class="erro"></span>
    </div>
    <div class="campo">
        <label asp-for="Senha"></label>
        <input asp-for="Senha" autocomplete="current-password" />
        <span asp-validation-for="Senha" class="erro"></span>
    </div>
    <button type="submit">Entrar</button>
</form>
<p><small>Os usuários de teste são criados pelo seed com senhas definidas em User Secrets (veja docs/roteiros/roteiro-06.md).</small></p>
