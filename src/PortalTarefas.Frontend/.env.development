# Configuração de DESENVOLVIMENTO do front-end. Não coloque segredos aqui:
# tudo que começa com VITE_ é embutido no JavaScript entregue ao navegador.

# URL base da API vista pelo navegador. Vazio = mesma origem, usando o proxy do Vite (recomendado).
# Para chamar a API diretamente (exige a política CORS "FrontendLocal" da API):
#   VITE_API_BASE_URL=https://localhost:7260
VITE_API_BASE_URL=

# Destino do proxy do servidor de desenvolvimento (usado só pelo vite.config.ts, não vai ao navegador).
API_PROXY_TARGET=https://localhost:7260
