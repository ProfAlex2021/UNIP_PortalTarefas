# =============================================================================
# Variáveis de configuração do Portal de Tarefas (Roteiro 8) — SEM VALORES SECRETOS.
# Copie para ".env" (que é ignorado pelo Git) e preencha para usar o docker-compose.yml.
# Em ASP.NET Core, ":" das chaves vira "__" (dois sublinhados) em variáveis de ambiente.
# Precedência: appsettings.json < appsettings.{Ambiente}.json < User Secrets (só Development)
#              < variáveis de ambiente < argumentos de linha de comando.
# =============================================================================

# ---- Usadas pelo docker-compose.yml ----
# Senha do usuário "sa" do SQL Server local em contêiner (mínimo 8 caracteres, com maiúscula,
# minúscula, número e símbolo). Também é usada para montar ConnectionStrings__PortalTarefas.
MSSQL_SA_PASSWORD=
# Senha da administradora criada pelo seed na primeira execução do contêiner.
SEED_ADMIN_SENHA=
# Commit que gerou a imagem (o CI preenche automaticamente).
COMMIT_SHA=local

# ---- Configurações lidas pela aplicação (referência) ----
# OBRIGATÓRIA. Conexão com o SQL Server.
# ConnectionStrings__PortalTarefas=
# OBRIGATÓRIA. URL base do serviço de calendário (feriados).
# Dependencias__Calendario__UrlBase=
# Ambiente: Development | Staging | Production (padrão da imagem: Production).
# ASPNETCORE_ENVIRONMENT=
# Aplicar migrations e seed ao iniciar (true só em ambientes de teste/dev).
# Banco__AplicarMigrationsNaInicializacao=false
# Habilitar a dependência simulada (/simulacao/calendario). Nunca em produção real.
# Simulacao__Habilitada=false
# Confiar em X-Forwarded-For/Proto de um proxy reverso que termina o TLS.
# Proxy__ConfiarCabecalhosEncaminhados=true
# Origens permitidas no CORS (só se o front-end for servido em outra origem).
# Cors__OrigensPermitidas__0=
# Limite de tentativas de login por IP e janela (segundos).
# Limites__Login__PermitidasPorJanela=5
# Limites__Login__JanelaSegundos=60
# Usuários de teste do seed (e-mail, nome, papel, equipe, senha).
# SeedUsuarios__0__Email=  SeedUsuarios__0__Nome=  SeedUsuarios__0__Papel=  SeedUsuarios__0__Equipe=  SeedUsuarios__0__Senha=
# Telemetria: exportar para o console ou para um coletor OTLP.
# Telemetria__ExportarConsole=false
# OTEL_EXPORTER_OTLP_ENDPOINT=
