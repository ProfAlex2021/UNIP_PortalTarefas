{
  "openapi": "3.1.1",
  "info": {
    "title": "Portal de Tarefas — API",
    "description": "API REST do Portal de Tarefas (Desenvolvimento Web com .NET — UNIP). Erros seguem Problem Details (RFC 9457). Enums são trafegados como texto.",
    "version": "v1"
  },
  "paths": {
    "/api/v1/tarefas": {
      "get": {
        "tags": [
          "Tarefas"
        ],
        "summary": "Lista tarefas com filtros, ordenação e paginação",
        "description": "Filtros, ordenação e paginação são aplicados no banco. Devolve também os cabeçalhos X-Total-Count e Link.",
        "operationId": "ListarTarefas",
        "parameters": [
          {
            "name": "pagina",
            "in": "query",
            "description": "Número da página, começando em 1.",
            "schema": {
              "maximum": 2147483647,
              "minimum": 1,
              "type": "integer",
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "tamanho",
            "in": "query",
            "description": "Itens por página (1 a 50).",
            "schema": {
              "maximum": 50,
              "minimum": 1,
              "type": "integer",
              "format": "int32",
              "default": 10
            }
          },
          {
            "name": "ordenarPor",
            "in": "query",
            "description": "Campo de ordenação: id, titulo, prazo, prioridade, situacao ou criadaEm.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "direcao",
            "in": "query",
            "description": "Direção da ordenação: asc ou desc.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "situacao",
            "in": "query",
            "description": "Filtra pela situação.",
            "schema": {
              "$ref": "#/components/schemas/SituacaoTarefa"
            }
          },
          {
            "name": "prioridade",
            "in": "query",
            "description": "Filtra pela prioridade.",
            "schema": {
              "$ref": "#/components/schemas/PrioridadeTarefa"
            }
          },
          {
            "name": "busca",
            "in": "query",
            "description": "Texto contido no título.",
            "schema": {
              "maxLength": 100,
              "minLength": 0,
              "type": "string"
            }
          }
        ],
        "responses": {
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "headers": {
              "X-Total-Count": {
                "description": "Total de itens que atendem aos filtros.",
                "schema": {
                  "type": "integer"
                }
              },
              "Link": {
                "description": "Links de navegação (RFC 8288) com rel first, prev, next e last.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginaTarefas"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Tarefas"
        ],
        "summary": "Cadastra uma tarefa",
        "description": "Devolve 201 com o cabeçalho Location apontando para a nova tarefa. Exige papel Usuario ou Administrador.",
        "operationId": "CriarTarefa",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TarefaCriacao"
              }
            }
          },
          "required": true
        },
        "responses": {
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TarefaDetalhe"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tarefas/{id}": {
      "get": {
        "tags": [
          "Tarefas"
        ],
        "summary": "Obtém uma tarefa pelo identificador",
        "operationId": "ObterTarefa",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TarefaDetalhe"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Tarefas"
        ],
        "summary": "Atualiza todos os campos editáveis de uma tarefa",
        "description": "Exige a 'versao' obtida no GET. Se a tarefa foi alterada por outra pessoa, devolve 409 com 'versaoAtual'. Só edita quem é da mesma equipe, o criador da tarefa, quem tem a permissão tarefas.editar-outras-equipes ou um Administrador (403).",
        "operationId": "AtualizarTarefa",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TarefaAtualizacao"
              }
            }
          },
          "required": true
        },
        "responses": {
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TarefaDetalhe"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Tarefas"
        ],
        "summary": "Exclui uma tarefa (somente Administrador)",
        "operationId": "ExcluirTarefa",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "204": {
            "description": "No Content"
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "Autenticação"
        ],
        "summary": "Autentica com e-mail e senha e emite o cookie de sessão",
        "operationId": "Entrar",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credenciais"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Sessao"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "Autenticação"
        ],
        "summary": "Encerra a sessão (invalida o cookie)",
        "operationId": "Sair",
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/api/auth/sessao": {
      "get": {
        "tags": [
          "Autenticação"
        ],
        "summary": "Informa se há sessão ativa e as permissões do usuário",
        "operationId": "ObterSessao",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Sessao"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Credenciais": {
        "required": [
          "email",
          "senha"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "senha": {
            "type": "string"
          }
        },
        "description": "Credenciais de acesso."
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "PaginaTarefas": {
        "required": [
          "itens",
          "pagina",
          "tamanho",
          "totalItens",
          "totalPaginas"
        ],
        "type": "object",
        "properties": {
          "itens": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TarefaResumo"
            }
          },
          "pagina": {
            "type": "integer",
            "format": "int32"
          },
          "tamanho": {
            "type": "integer",
            "format": "int32"
          },
          "totalItens": {
            "type": "integer",
            "format": "int32"
          },
          "totalPaginas": {
            "type": "integer",
            "format": "int32"
          }
        },
        "description": "Uma página de tarefas e os metadados de paginação."
      },
      "PrioridadeTarefa": {
        "enum": [
          "Baixa",
          "Media",
          "Alta"
        ]
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "Sessao": {
        "required": [
          "autenticado",
          "nome",
          "email",
          "equipe",
          "papeis",
          "permissoes"
        ],
        "type": "object",
        "properties": {
          "autenticado": {
            "type": "boolean"
          },
          "nome": {
            "type": [
              "null",
              "string"
            ]
          },
          "email": {
            "type": [
              "null",
              "string"
            ]
          },
          "equipe": {
            "type": [
              "null",
              "string"
            ]
          },
          "papeis": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "permissoes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Políticas gerais atendidas pelo usuário (ex.: tarefas.criar, tarefas.excluir)."
          }
        },
        "description": "Estado da sessão atual. As permissões são calculadas pelo servidor a partir das políticas."
      },
      "SituacaoTarefa": {
        "enum": [
          "Pendente",
          "EmAndamento",
          "Concluida"
        ]
      },
      "TarefaAtualizacao": {
        "required": [
          "titulo",
          "descricao",
          "prioridade",
          "prazo",
          "situacao",
          "versao"
        ],
        "type": "object",
        "properties": {
          "titulo": {
            "maxLength": 100,
            "minLength": 3,
            "type": "string"
          },
          "descricao": {
            "maxLength": 500,
            "minLength": 0,
            "type": [
              "null",
              "string"
            ]
          },
          "prioridade": {
            "$ref": "#/components/schemas/PrioridadeTarefa"
          },
          "prazo": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          },
          "situacao": {
            "$ref": "#/components/schemas/SituacaoTarefa"
          },
          "versao": {
            "type": "string",
            "description": "Valor de 'versao' recebido no GET. Se a tarefa mudou desde então, a resposta é 409."
          }
        },
        "description": "Dados para atualizar uma tarefa. Substitui todos os campos editáveis."
      },
      "TarefaCriacao": {
        "required": [
          "titulo"
        ],
        "type": "object",
        "properties": {
          "titulo": {
            "maxLength": 100,
            "minLength": 3,
            "type": "string",
            "description": "Título da tarefa (3 a 100 caracteres)."
          },
          "descricao": {
            "maxLength": 500,
            "minLength": 0,
            "type": [
              "null",
              "string"
            ],
            "description": "Descrição opcional (até 500 caracteres)."
          },
          "prioridade": {
            "description": "Prioridade da tarefa. Padrão: Media.",
            "$ref": "#/components/schemas/PrioridadeTarefa"
          },
          "prazo": {
            "type": [
              "null",
              "string"
            ],
            "description": "Prazo opcional (AAAA-MM-DD). Obrigatório para prioridade Alta; não pode estar no passado.",
            "format": "date"
          }
        },
        "description": "Dados para cadastrar uma tarefa."
      },
      "TarefaDetalhe": {
        "required": [
          "id",
          "titulo",
          "descricao",
          "situacao",
          "prioridade",
          "prazo",
          "criadaEm",
          "atualizadaEm",
          "versao",
          "equipe"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "titulo": {
            "type": "string"
          },
          "descricao": {
            "type": [
              "null",
              "string"
            ]
          },
          "situacao": {
            "$ref": "#/components/schemas/SituacaoTarefa"
          },
          "prioridade": {
            "$ref": "#/components/schemas/PrioridadeTarefa"
          },
          "prazo": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          },
          "criadaEm": {
            "type": "string",
            "format": "date-time"
          },
          "atualizadaEm": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "versao": {
            "type": "string",
            "description": "Token de concorrência (Base64). Envie-o de volta no PUT."
          },
          "equipe": {
            "type": "string",
            "description": "Equipe dona da tarefa. Editar tarefas de outra equipe exige permissão específica."
          }
        },
        "description": "Representação completa de uma tarefa."
      },
      "TarefaResumo": {
        "required": [
          "id",
          "titulo",
          "situacao",
          "prioridade",
          "prazo",
          "vencida",
          "equipe"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "titulo": {
            "type": "string"
          },
          "situacao": {
            "$ref": "#/components/schemas/SituacaoTarefa"
          },
          "prioridade": {
            "$ref": "#/components/schemas/PrioridadeTarefa"
          },
          "prazo": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          },
          "vencida": {
            "type": "boolean",
            "description": "Verdadeiro quando o prazo já passou e a tarefa não foi concluída."
          },
          "equipe": {
            "type": "string",
            "description": "Equipe dona da tarefa."
          }
        },
        "description": "Item da listagem de tarefas."
      }
    }
  },
  "tags": [
    {
      "name": "Tarefas"
    },
    {
      "name": "Autenticação"
    }
  ]
}